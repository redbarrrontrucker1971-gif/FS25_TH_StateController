			<effectNode effectNode="0>21|15" materialType="unloadingSmoke" materialTypeId="1" fadeTime="0.5" />
			<effectNode effectNode="0>21|16" materialType="unloadingSmoke" materialTypeId="1" fadeTime="0.5" />
