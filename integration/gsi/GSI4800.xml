        <storage node="storage" fillTypes="MAIZE CORN_DRY" capacity="1000000" fillLevelSyncThreshold="50" isExtension="false"/>

        <playerTrigger node="playerTrigger"/>

        <sounds>
            <idle template="grainMillIdle" linkNode="0>"/>
